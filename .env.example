# ============================================================
# MATRIXFLOW ENTERPRISE - VARIABLES DE ENTORNO
# Archivo de referencia. No colocar secretos reales en Git.
# ============================================================

# Backend
NOMBRE_APP=MatrixFlow Enterprise API
VERSION=1.0.0
ENTORNO=desarrollo
FRONTEND_URL=http://localhost:5173

# PostgreSQL
# Sustituye usuario, contraseña, host, puerto y base de datos.
DATABASE_URL=postgresql+psycopg://matrixflow:CAMBIAR_PASSWORD@localhost:5432/matrixflow

# Seguridad JWT
JWT_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Docker Compose - PostgreSQL local opcional
POSTGRES_DB=matrixflow
POSTGRES_USER=matrixflow
POSTGRES_PASSWORD=CAMBIAR_PASSWORD
POSTGRES_PORT=5432